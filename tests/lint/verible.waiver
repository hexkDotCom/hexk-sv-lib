# Waivers for verible-verilog-lint (Gate 1). Every waiver names the rule and the reason.

# hexk_rand_stream owns its seed: the seeded $random and $dist_* functions are its whole
# point. $urandom, which the rule recommends, takes its state from the thread.
waive --rule=invalid-system-task-function --location="src/core/hexk_rand_stream.sv"

# hexk_plusarg is the one place that wraps the plusarg system functions. It needs
# $test$plusargs to tell "+name without a value" from "no such plusarg", which
# $value$plusargs cannot report portably.
waive --rule=plusarg-assignment --location="src/core/hexk_plusarg.sv"

# The test of hexk_check_q_eq compares arrays whose index ranges differ; one of them falls,
# which is the case the check has to get right.
waive --rule=unpacked-dimensions-range-ordering --location="tests/unit/hexk_check_macros/hexk_check_macros_unit_test.sv"
